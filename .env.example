# Where the gateway reaches Forgejo (inside your network is fine).
FORGEJO_URL=http://forgejo:3000
# The Forgejo address people open in a browser, for links on the consent page. Defaults to FORGEJO_URL.
FORGEJO_PUBLIC_URL=https://git.example.com

# OAuth for hosted assistants (ChatGPT). Set both, or neither for token-only mode.
# PUBLIC_URL is this gateway's public HTTPS address; it is the OAuth issuer.
PUBLIC_URL=https://forgejo-mcp.example.com
# 32+ random bytes, hex or base64: openssl rand -hex 32
SECRET_KEY=

# Accept a Forgejo access token directly as the bearer token (Claude Code, scripts).
ALLOW_FORGEJO_TOKENS=true

# Behind a proxy that sets the caller's address (e.g. Cloudflare), name its header
# so rate limits apply per caller rather than per proxy.
# TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP
